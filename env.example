# Clerk 认证相关
# 从 https://dashboard.clerk.com 获取
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/:locale/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/:locale/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/:locale
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/:locale
NEXT_PUBLIC_DEFAULT_LOCALE=zh

# API 密钥（如果需要 AI 功能）
OPENAI_API_KEY=your_openai_api_key
# 从 https://aistudio.google.com/apikey 获取
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-preview-05-20
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-preview-05-20

# 数据库连接
# 本地开发示例（请改成你自己的密码与端口）
POSTGRES_URL=postgresql://postgres:your_password@localhost:3333/aicollager
# Supabase 生产连接示例（勿提交真实密码）:
# POSTGRES_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Cloudflare R2 对象存储
# 从 Cloudflare Dashboard > R2 > Manage R2 API Tokens 创建
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_PUBLIC_URL="https://your-cdn-domain.example.com"
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name

NODE_ENV=development

# Supabase
# 从 https://supabase.com/dashboard/project/_/settings/api 获取
NEXT_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 本地 Postgres 示例（可选）:
# docker run --name aicollager \
#   -e POSTGRES_PASSWORD=your_password \
#   -e POSTGRES_DB=aicollager \
#   -p 3333:5432 \
#   -v aicollager_data:/var/lib/postgresql/data \
#   --restart=always \
#   -d postgres
