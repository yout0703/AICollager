# =============================================================================
# AICollager environment template
# Copy to .env.local and fill in real values. Never commit secrets.
# =============================================================================

# --- App ---
# Public site origin (invite links, absolute URLs). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated admin emails (required for /api/admin/*)
ADMIN_EMAILS=you@example.com
# Opt-in Vercel Analytics for production deploys on Vercel
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Allow POST /api/upload-image to write under public/uploads (dev only by default)
ALLOW_LOCAL_UPLOAD=false
NODE_ENV=development
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Clerk auth (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/:locale/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/:locale/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/:locale
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/:locale

# --- OpenAI 图像生成（gpt-image-2） ---
# 可直连 OpenAI 官方，或接兼容 OpenAI API 的中转站（如 onehop.ai）。
# 1) API Key / Bearer token：官方填 sk-...；中转站填其颁发的 token（SDK 自动以 Authorization: Bearer 发送）
OPENAI_API_KEY=your_openai_api_key
# 2) Base URL：留空走官方(https://api.openai.com/v1)；中转站填其 v1 根地址
OPENAI_BASE_URL=https://api.onehop.ai/v1
# 3) 图像生成模型名：官方 gpt-image-2；中转站按其命名(如 openai/gpt-image-2)
OPENAI_IMAGE_MODEL=openai/gpt-image-2
# Prompt 智能编排模型（vision-capable）：根据参考图张数/风格/宽高比生成最优提示词
# 中转站需确认支持 vision 的文本模型名；若无，可设 OPENAI_ORCHESTRATOR_ENABLED=false 走降级拼接
OPENAI_ORCHESTRATOR_MODEL=openai/gpt-4o
# 是否启用智能编排（false=直接拼接 prompt 作为降级 fallback）
OPENAI_ORCHESTRATOR_ENABLED=true
# 每用户每日生成/编辑上限
OPENAI_USER_DAILY_LIMIT=30

# --- Database (Postgres) ---
# Local example:
POSTGRES_URL=postgresql://postgres:your_password@localhost:3333/aicollager
# Or Supabase direct connection (use a strong password; never commit it):
# POSTGRES_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres
# DATABASE_URL=...  # alternative name also supported

# --- Supabase client (https://supabase.com/dashboard/project/_/settings/api) ---
NEXT_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Cloudflare R2 (Dashboard > R2 > Manage R2 API Tokens) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-cdn-domain.example.com

# --- Optional local Postgres ---
# docker run --name aicollager \
#   -e POSTGRES_PASSWORD=your_password \
#   -e POSTGRES_DB=aicollager \
#   -p 3333:5432 \
#   -v aicollager_data:/var/lib/postgresql/data \
#   --restart=always \
#   -d postgres
